+    pub fn provdesk_id_at(file: &Path) -> Result<String> {
+        let config = Self::provdesk_config_at(file)?;
+        if config.enc_id.is_empty() {
+            return Ok(config.id);
+        }
+        let (id, decrypted, _) = decrypt_str_or_original(&config.enc_id, PASSWORD_ENC_VERSION);
+        anyhow::ensure!(
+            decrypted && !id.is_empty(),
+            "Unable to decrypt the stored ProVdesk ID"
+        );
+        Ok(id)
+    }
+
+    #[cfg(windows)]
+    fn provdesk_config_at(file: &Path) -> Result<Config> {
+        use std::os::windows::fs::OpenOptionsExt;
+
+        fn read(file: &Path) -> Result<Config> {
+            match fs::read_to_string(file) {
+                Ok(data) => Ok(toml::from_str(&data)?),
+                Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(Config::default()),
+                Err(err) => Err(err.into()),
+            }
+        }
+
+        let config = read(file)?;
+        if !config.id.is_empty() || !config.enc_id.is_empty() {
+            return Ok(config);
+        }
+        fs::create_dir_all(
+            file.parent()
+                .ok_or_else(|| anyhow!("Missing config directory"))?,
+        )?;
+        // Windows releases the exclusive handle even if the initializing process exits.
+        let lock_path = file.with_extension("identity.lock");
+        let started = Instant::now();
+        let _guard = loop {
+            match fs::OpenOptions::new()
+                .write(true)
+                .create(true)
+                .truncate(false)
+                .share_mode(0)
+                .open(&lock_path)
+            {
+                Ok(lock) => break lock,
+                Err(err)
+                    if err.raw_os_error() == Some(32)
+                        && started.elapsed() < Duration::from_secs(3) =>
+                {
+                    std::thread::sleep(Duration::from_millis(20));
+                }
+                Err(err) => return Err(err.into()),
+            }
+        };
+        let mut config = read(file)?;
+        if config.initialize_provdesk_identity() {
+            // Without a machine UID, encryption falls back to this process's key pair.
+            // Keep the supported plain ID until the host can store it with its own key.
+            if machine_uid::get().is_ok() {
+                config.enc_id =
+                    encrypt_str_or_original(&config.id, PASSWORD_ENC_VERSION, ENCRYPT_MAX_LEN);
+                anyhow::ensure!(
+                    config.enc_id != config.id && !config.enc_id.is_empty(),
+                    "Unable to encrypt ProVdesk ID"
+                );
+                config.id.clear();
+            }
+            store_path(file.to_owned(), &config)?;
+        }
+        Ok(config)
+    }
+
+    fn new_provdesk_id() -> String {
+        let mut rng = rand::thread_rng();
+        let index = rng.gen_range(0..52u8);
+        let first = if index < 26 {
+            b'A' + index
+        } else {
+            b'a' + index - 26
+        };
+        let mut id = String::with_capacity(15);
+        id.push(char::from(first));
+        id.extend(rng.sample_iter(Alphanumeric).take(14).map(char::from));
+        id
+    }
+
+    fn initialize_provdesk_identity(&mut self) -> bool {
+        if option_env!("RUSTDESK_APP_NAME") != Some("ProVdesk")
+            || !self.id.is_empty()
+            || !self.enc_id.is_empty()
+        {
+            return false;
+        }
+        self.id = Self::new_provdesk_id();
+        self.provdesk_registration_retries = Some(0);
+        true
+    }
+
+    fn retry_fresh_provdesk_identity(&mut self) -> bool {
+        if option_env!("RUSTDESK_APP_NAME") != Some("ProVdesk") {
+            return false;
+        }
+        let Some(retries) = self.provdesk_registration_retries else {
+            return false;
+        };
+        if retries >= PROVDESK_REGISTRATION_RETRY_LIMIT {
+            return false;
+        }
+        self.id = Self::new_provdesk_id();
+        self.provdesk_registration_retries = Some(retries + 1);
+        self.key_confirmed = false;
+        self.keys_confirmed.clear();
+        true
+    }
+
+    pub fn is_pending_provdesk_registration() -> bool {
+        option_env!("RUSTDESK_APP_NAME") == Some("ProVdesk")
+            && CONFIG.read().unwrap().provdesk_registration_retries.is_some()
+    }
+
+    pub fn retry_provdesk_registration() -> bool {
+        let mut config = CONFIG.write().unwrap();
+        if !config.retry_fresh_provdesk_identity() {
+            return false;
+        }
+        config.store();
+        true
+    }
+
+    fn finish_fresh_provdesk_registration(&mut self) -> bool {
+        option_env!("RUSTDESK_APP_NAME") == Some("ProVdesk")
+            && self.provdesk_registration_retries.take().is_some()
+    }
+
+    pub fn confirm_provdesk_registration() {
+        let mut config = CONFIG.write().unwrap();
+        if config.finish_fresh_provdesk_registration() {
+            config.store();
+        }
+    }
