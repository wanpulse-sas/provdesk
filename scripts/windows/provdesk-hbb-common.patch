+    fn new_provdesk_id() -> String {
+        let mut rng = rand::thread_rng();
+        let index = rng.gen_range(0..52u8);
+        let first = if index < 26 {
+            b'A' + index
+        } else {
+            b'a' + index - 26
+        };
+        let mut id = String::with_capacity(15);
+        id.push(char::from(first));
+        id.extend(rng.sample_iter(Alphanumeric).take(14).map(char::from));
+        id
+    }
+
+    fn initialize_provdesk_identity(&mut self) -> bool {
+        if option_env!("RUSTDESK_APP_NAME") != Some("ProVdesk")
+            || !self.id.is_empty()
+            || !self.enc_id.is_empty()
+        {
+            return false;
+        }
+        self.id = Self::new_provdesk_id();
+        self.provdesk_registration_retries = Some(0);
+        true
+    }
+
+    fn retry_fresh_provdesk_identity(&mut self) -> bool {
+        if option_env!("RUSTDESK_APP_NAME") != Some("ProVdesk") {
+            return false;
+        }
+        let Some(retries) = self.provdesk_registration_retries else {
+            return false;
+        };
+        if retries >= PROVDESK_REGISTRATION_RETRY_LIMIT {
+            return false;
+        }
+        self.id = Self::new_provdesk_id();
+        self.provdesk_registration_retries = Some(retries + 1);
+        self.key_confirmed = false;
+        self.keys_confirmed.clear();
+        true
+    }
+
+    pub fn is_pending_provdesk_registration() -> bool {
+        option_env!("RUSTDESK_APP_NAME") == Some("ProVdesk")
+            && CONFIG.read().unwrap().provdesk_registration_retries.is_some()
+    }
+
+    pub fn retry_provdesk_registration() -> bool {
+        let mut config = CONFIG.write().unwrap();
+        if !config.retry_fresh_provdesk_identity() {
+            return false;
+        }
+        config.store();
+        true
+    }
+
+    fn finish_fresh_provdesk_registration(&mut self) -> bool {
+        option_env!("RUSTDESK_APP_NAME") == Some("ProVdesk")
+            && self.provdesk_registration_retries.take().is_some()
+    }
+
+    pub fn confirm_provdesk_registration() {
+        let mut config = CONFIG.write().unwrap();
+        if config.finish_fresh_provdesk_registration() {
+            config.store();
+        }
+    }
