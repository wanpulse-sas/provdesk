+        if option_env!("RUSTDESK_APP_NAME") != Some("ProVdesk") {
+            return;
+        }
+        let keys = (vec![7; 64], vec![8; 32]);
+        let mut config = Config {
+            key_pair: keys.clone(),
+            ..Default::default()
+        };
+        assert!(config.initialize_provdesk_identity());
+        for expected in 1..=2 {
+            assert!(config.retry_fresh_provdesk_identity());
+            assert!(crate::is_valid_custom_id(&config.id));
+            assert_eq!(config.id.len(), 15);
+            assert_eq!(config.key_pair, keys);
+            config = toml::from_str(&toml::to_string(&config).unwrap()).unwrap();
+            assert_eq!(config.provdesk_registration_retries, Some(expected));
+        }
+        let saved = config.id.clone();
+        assert!(!config.retry_fresh_provdesk_identity());
+        assert_eq!(config.id, saved);
+    }
